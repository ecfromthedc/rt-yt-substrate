# rt-yt-substrate — env var contract
# Real values held outside the repo (e.g. ~/.cortextos/default/rt-yt-automations.env)
# Never commit real credentials.

# Postgres (Railway, project: rt-yt-automations)
YT_AUTOMATIONS_DATABASE_URL=postgresql://USER:PASS@HOST:PORT/DB

# Notion (parent page: YouTube Automations)
NOTION_API_TOKEN=secret_...
NOTION_PARENT_PAGE_ID=your_notion_parent_page_id

# Neo4j (HTTP wrapper over Cloudflare tunnel from Eric's Mac)
NEO4J_HTTP_URL=https://your-neo4j-host.example.com
NEO4J_HTTP_TOKEN=...

# rt-yt-knowledge (private repo, agent-side clone)
YT_KNOWLEDGE_REPO=ecfromthedc/rt-yt-knowledge
YT_KNOWLEDGE_LOCAL_PATH=~/Projects/active/rt-yt-knowledge

# youtube-growth-playbook (public reference)
YT_PLAYBOOK_REPO=ecfromthedc/youtube-growth-playbook

# Ollama (local, for /teardown extraction)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
